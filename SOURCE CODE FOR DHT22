static void DWT_Init(void)
{
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
}

static void DHT22_Delay_us(uint32_t us)
{
    uint32_t start = DWT->CYCCNT;
    uint32_t ticks = us * (HAL_RCC_GetHCLKFreq() / 1000000);

    while ((DWT->CYCCNT - start) < ticks)
    {
    }
}

/* =========================================================
 *                    DHT22 FUNCTIONS
 * ========================================================= */

static void DHT22_SetOutput(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    GPIO_InitStruct.Pin = DHT22_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_OD;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;

    HAL_GPIO_Init(DHT22_PORT, &GPIO_InitStruct);
}

static void DHT22_SetInput(void)
{
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    GPIO_InitStruct.Pin = DHT22_PIN;
    GPIO_InitStruct.Mode = GPIO_MODE_INPUT;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;

    HAL_GPIO_Init(DHT22_PORT, &GPIO_InitStruct);
}

static uint8_t DHT22_Start(void)
{
    uint8_t response = 0;

    DHT22_SetOutput();

    /* Start signal */
    HAL_GPIO_WritePin(DHT22_PORT, DHT22_PIN, GPIO_PIN_RESET);

    HAL_Delay(2);

    /* Release line */
    HAL_GPIO_WritePin(DHT22_PORT, DHT22_PIN, GPIO_PIN_SET);

    DHT22_Delay_us(30);

    DHT22_SetInput();

    /* DHT22 pulls LOW for about 80 us */
    uint32_t timeout = 0;

    while (HAL_GPIO_ReadPin(DHT22_PORT, DHT22_PIN) == GPIO_PIN_SET)
    {
        DHT22_Delay_us(1);

        if (++timeout > 100)
            return 0;
    }

    timeout = 0;

    while (HAL_GPIO_ReadPin(DHT22_PORT, DHT22_PIN) == GPIO_PIN_RESET)
    {
        DHT22_Delay_us(1);

        if (++timeout > 100)
            return 0;
    }

    timeout = 0;

    while (HAL_GPIO_ReadPin(DHT22_PORT, DHT22_PIN) == GPIO_PIN_SET)
    {
        DHT22_Delay_us(1);

        if (++timeout > 100)
            return 0;
    }

    response = 1;

    return response;
}

static uint8_t DHT22_ReadByte(void)
{
    uint8_t i;
    uint8_t byte = 0;

    for (i = 0; i < 8; i++)
    {
        /* Wait for the beginning of bit */
        uint32_t timeout = 0;

        while (HAL_GPIO_ReadPin(DHT22_PORT, DHT22_PIN) == GPIO_PIN_RESET)
        {
            DHT22_Delay_us(1);

            if (++timeout > 100)
                return 0;
        }

        /*
         * After approximately 40 us:
         *
         * LOW  = bit 0
         * HIGH = bit 1
         */
        DHT22_Delay_us(40);

        if (HAL_GPIO_ReadPin(DHT22_PORT, DHT22_PIN) == GPIO_PIN_SET)
        {
            byte |= (1 << (7 - i));
        }

        timeout = 0;

        while (HAL_GPIO_ReadPin(DHT22_PORT, DHT22_PIN) == GPIO_PIN_SET)
        {
            DHT22_Delay_us(1);

            if (++timeout > 100)
                break;
        }
    }

    return byte;
}

static uint8_t DHT22_Read(float *temperature, float *humidity)
{
    uint8_t data[5];

    if (!DHT22_Start())
    {
        return 0;
    }

    for (int i = 0; i < 5; i++)
    {
        data[i] = DHT22_ReadByte();
    }

    /* Checksum */
    uint8_t checksum =
        data[0] +
        data[1] +
        data[2] +
        data[3];

    if (checksum != data[4])
    {
        return 0;
    }

    /* Humidity */
    uint16_t rawHumidity =
        ((uint16_t)data[0] << 8) | data[1];

    *humidity = rawHumidity / 10.0f;

    /* Temperature */
    uint16_t rawTemperature =
        ((uint16_t)(data[2] & 0x7F) << 8) | data[3];

    *temperature = rawTemperature / 10.0f;

    if (data[2] & 0x80)
    {
        *temperature = -*temperature;
    }

    return 1;
}

/* =========================================================
 *                    LCD FUNCTIONS
 * ========================================================= */

/*
 * PCF8574 LCD backpack mapping:
 *
 * P0 = RS
 * P1 = RW
 * P2 = EN
 * P3 = Backlight
 * P4 = D4
 * P5 = D5
 * P6 = D6
 * P7 = D7
 */

#define LCD_RS      0x01
#define LCD_RW      0x02
#define LCD_EN      0x04
#define LCD_BACK    0x08

static void LCD_Write4(uint8_t data)
{
    uint8_t value = data | LCD_BACK;

    /* EN HIGH */
    uint8_t high = value | LCD_EN;

    HAL_I2C_Master_Transmit(
        &hi2c1,
        LCD_I2C_ADDRESS,
        &high,
        1,
        100
    );

    /* EN LOW */
    uint8_t low = value & ~LCD_EN;

    HAL_I2C_Master_Transmit(
        &hi2c1,
        LCD_I2C_ADDRESS,
        &low,
        1,
        100
    );
}

static void LCD_SendCommand(uint8_t cmd)
{
    uint8_t high = (cmd & 0xF0);
    uint8_t low  = ((cmd << 4) & 0xF0);

    LCD_Write4(high);
    LCD_Write4(low);

    HAL_Delay(2);
}

static void LCD_SendData(uint8_t data)
{
    uint8_t high = (data & 0xF0) | LCD_RS;
    uint8_t low  = ((data << 4) & 0xF0) | LCD_RS;

    LCD_Write4(high);
    LCD_Write4(low);

    DHT22_Delay_us(50);
}

static void LCD_Init(void)
{
    HAL_Delay(50);

    /* LCD initialization sequence */
    LCD_Write4(0x30);
    HAL_Delay(5);

    LCD_Write4(0x30);
    DHT22_Delay_us(150);

    LCD_Write4(0x30);
    DHT22_Delay_us(150);

    LCD_Write4(0x20);
    DHT22_Delay_us(150);

    /* 4-bit mode */
    LCD_SendCommand(0x28);

    /* Display ON, cursor OFF */
    LCD_SendCommand(0x0C);

    /* Entry mode */
    LCD_SendCommand(0x06);

    /* Clear */
    LCD_SendCommand(0x01);

    HAL_Delay(5);
}

static void LCD_Clear(void)
{
    LCD_SendCommand(0x01);
    HAL_Delay(2);
}

static void LCD_SetCursor(uint8_t row, uint8_t column)
{
    uint8_t address;

    if (row == 0)
    {
        address = 0x80 + column;
    }
    else
    {
        address = 0xC0 + column;
    }

    LCD_SendCommand(address);
}

static void LCD_PrintString(char *str)
{
    while (*str)
    {
        LCD_SendData((uint8_t)*str);
        str++;
    }
}

/* =========================================================
 *                         MAIN
 * ========================================================= */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();

    MX_I2C1_Init();

    DWT_Init();

    /* LCD start */
    LCD_Init();

    LCD_Clear();

    LCD_SetCursor(0, 0);
    LCD_PrintString("STM32 DHT22");

    LCD_SetCursor(1, 0);
    LCD_PrintString("Starting...");

    HAL_Delay(2000);

    float temperature = 0.0f;
    float humidity = 0.0f;

    char line1[17];
    char line2[17];

    while (1)
    {
        if (DHT22_Read(&temperature, &humidity))
        {
            /*
             * Keep each line <= 16 characters.
             *
             * Example:
             * Temp: 25.4 C
             * Hum : 60.2 %
             */

            int temp_int = (int)temperature;
            int temp_dec = (int)((temperature - temp_int) * 10);

            int hum_int = (int)humidity;
            int hum_dec = (int)((humidity - hum_int) * 10);

            if (temp_dec < 0)
                temp_dec = -temp_dec;

            if (hum_dec < 0)
                hum_dec = -hum_dec;

            snprintf(
                line1,
                sizeof(line1),
                "Temp: %2d.%1d C",
                temp_int,
                temp_dec
            );

            snprintf(
                line2,
                sizeof(line2),
                "Hum : %2d.%1d %%",
                hum_int,
                hum_dec
            );

            LCD_SetCursor(0, 0);
            LCD_PrintString("                ");

            LCD_SetCursor(0, 0);
            LCD_PrintString(line1);

            LCD_SetCursor(1, 0);
            LCD_PrintString("                ");

            LCD_SetCursor(1, 0);
            LCD_PrintString(line2);
        }
        else
        {
            LCD_SetCursor(0, 0);
            LCD_PrintString("DHT22 Error     ");

            LCD_SetCursor(1, 0);
            LCD_PrintString("Check Sensor    ");
        }

        /*
         * DHT22 requires at least about 2 seconds
         * between measurements.
         */
        HAL_Delay(2000);
    }
}

