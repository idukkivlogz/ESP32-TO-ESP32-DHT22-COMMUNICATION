/* =========================
   DHT11 START SIGNAL
   ========================= */

static uint8_t DHT11_Start(void)
{
    uint32_t timeout;

    DHT11_SetOutput();

    /* Start signal */
    HAL_GPIO_WritePin(DHT11_PORT, DHT11_PIN, GPIO_PIN_RESET);
    HAL_Delay(20);

    HAL_GPIO_WritePin(DHT11_PORT, DHT11_PIN, GPIO_PIN_SET);
    DHT11_Delay_us(30);

    DHT11_SetInput();

    /* DHT11 pulls LOW */
    timeout = 0;
    while (HAL_GPIO_ReadPin(DHT11_PORT, DHT11_PIN) == GPIO_PIN_SET)
    {
        if (++timeout > 100)
            return 0;

        DHT11_Delay_us(1);
    }

    /* DHT11 pulls HIGH */
    timeout = 0;
    while (HAL_GPIO_ReadPin(DHT11_PORT, DHT11_PIN) == GPIO_PIN_RESET)
    {
        if (++timeout > 100)
            return 0;

        DHT11_Delay_us(1);
    }

    /* DHT11 pulls LOW */
    timeout = 0;
    while (HAL_GPIO_ReadPin(DHT11_PORT, DHT11_PIN) == GPIO_PIN_SET)
    {
        if (++timeout > 100)
            return 0;

        DHT11_Delay_us(1);
    }

    return 1;
}

/* =========================
   READ ONE BYTE
   ========================= */

static uint8_t DHT11_ReadByte(void)
{
    uint8_t i;
    uint8_t data = 0;

    for (i = 0; i < 8; i++)
    {
        uint32_t timeout = 0;

        /* Wait for LOW to finish */
        while (HAL_GPIO_ReadPin(DHT11_PORT, DHT11_PIN) == GPIO_PIN_RESET)
        {
            if (++timeout > 100)
                return 0;

            DHT11_Delay_us(1);
        }

        /* Wait approximately 40 us */
        DHT11_Delay_us(40);

        /*
         * If pin is still HIGH after 40 us,
         * bit = 1.
         * Otherwise bit = 0.
         */
        if (HAL_GPIO_ReadPin(DHT11_PORT, DHT11_PIN) == GPIO_PIN_SET)
        {
            data |= (1 << (7 - i));
        }

        timeout = 0;

        /* Wait until HIGH ends */
        while (HAL_GPIO_ReadPin(DHT11_PORT, DHT11_PIN) == GPIO_PIN_SET)
        {
            if (++timeout > 100)
                break;

            DHT11_Delay_us(1);
        }
    }

    return data;
}

/* =========================
   READ DHT11
   ========================= */

static uint8_t DHT11_Read(uint8_t *temperature, uint8_t *humidity)
{
    uint8_t data[5];

    if (!DHT11_Start())
        return 0;

    data[0] = DHT11_ReadByte();   // Humidity integer
    data[1] = DHT11_ReadByte();   // Humidity decimal
    data[2] = DHT11_ReadByte();   // Temperature integer
    data[3] = DHT11_ReadByte();   // Temperature decimal
    data[4] = DHT11_ReadByte();   // Checksum

    /* Verify checksum */
    if ((uint8_t)(data[0] + data[1] + data[2] + data[3]) != data[4])
    {
        return 0;
    }

    *humidity = data[0];
    *temperature = data[2];

    return 1;
}

/* =========================
   MAIN
   ========================= */

int main(void)
{
    uint8_t temperature;
    uint8_t humidity;

    char line1[17];
    char line2[17];

    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();

    DWT_Init();

    /* LCD */
    LCD_Init();

    HAL_Delay(500);

    LCD_Clear();

    LCD_Set_Cursor(0, 0);
    LCD_Print("STM32 DHT11");

    LCD_Set_Cursor(1, 0);
    LCD_Print("Starting...");

    HAL_Delay(2000);

    LCD_Clear();

    while (1)
    {
        if (DHT11_Read(&temperature, &humidity))
        {
            /*
             * 16 character LCD
             */

            snprintf(line1, sizeof(line1),
                     "Temp: %d C",
                     temperature);

            snprintf(line2, sizeof(line2),
                     "Hum : %d %%",
                     humidity);

            LCD_Clear();

            LCD_Set_Cursor(0, 0);
            LCD_Print(line1);

            LCD_Set_Cursor(1, 0);
            LCD_Print(line2);
        }
        else
        {
            LCD_Clear();

            LCD_Set_Cursor(0, 0);
            LCD_Print("DHT11 ERROR");

            LCD_Set_Cursor(1, 0);
            LCD_Print("Check sensor");
        }

        /*
         * DHT11 should not be read too quickly.
         * Wait at least 2 seconds.
         */
        HAL_Delay(2000);
    }
}

